# Local development defaults. Copy to .env only when values need to be overridden.
POSTGRES_DB=fincore
POSTGRES_USER=fincore
POSTGRES_PASSWORD=fincore_local
POSTGRES_PORT=5432

# Spring Boot recibe estos valores solo si se exportan al proceso; no carga .env automáticamente.
DB_URL=jdbc:postgresql://localhost:5432/fincore
DB_USERNAME=fincore
DB_PASSWORD=fincore_local

# En HTTPS debe ser true. Localmente se mantiene false porque se usa http://localhost.
SESSION_COOKIE_SECURE=false

# Estas variables también deben exportarse si se quiere iniciar Spring sin los comandos documentados.
SPRING_PROFILES_ACTIVE=local
REGISTRATION_ENABLED=true

# Límite por transferencia del simulador; no representa un límite bancario real.
TRANSFER_MAXIMUM_AMOUNT=100000.00
