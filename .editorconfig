# This is the root EditorConfig file
root = true

# Default rules for every text file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Java convention
[*.java]
indent_size = 4

# Preserve intentional Markdown line breaks
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab
